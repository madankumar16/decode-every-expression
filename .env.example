# Copy to .env for local use, or set these in your host's environment settings.
# Never commit a real .env file.

# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 only on your own computer. Never in production.
FLASK_DEBUG=0

# Set to 1 when running behind a proxy/load balancer that terminates HTTPS
# (Hugging Face Spaces, Render, Railway, Cloud Run, nginx).
TRUST_PROXY=1

# Set to None so sign-in also works inside the huggingface.co Space page (iframe).
# The session cookie is then Secure and Partitioned. Leave as Lax otherwise.
SESSION_COOKIE_SAMESITE=Lax

# Extra origins allowed to open the live socket (comma separated). Leave empty for same-site only.
ALLOWED_ORIGINS=

# Shown in the footer. Leave blank to hide.
SITE_NAME=EmotiSense
SITE_OWNER=
CONTACT_EMAIL=
CONTACT_PHONE=
BUSINESS_ADDRESS=

# Optional: where the database and snapshots are kept (must be persistent storage).
# DATABASE_PATH=/data/app.db
# CAPTURE_DIR=/data/captures
# Optional: shared rate-limit storage, e.g. redis://localhost:6379
# RATELIMIT_STORAGE_URI=memory://
